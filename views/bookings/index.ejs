

<% layout("/layouts/boilerplate") %>

<h2 class="ms-3 mt-2">My Bookings</h2>

<% if (bookings.length === 0) { %>
  <p>You have no bookings yet.</p>
<% } else { %>
  <div class="row ">
    <% bookings.forEach(booking => { %>
      <div class="col-md-2 mb-3 ms-3 ">
        <div class="card h-100 mb-2">
          <img src="<%= booking.listing.image.url %>" 
               class="bcard-img-top ms-2 mt-2" 
               alt="listing_image" 
               height="200" 
               width="200">
          <div class="card-body  offset-1 ">
            <h5 class="card-title"><%= booking.listing.title %></h5>
            <p><strong>Check-In:</strong> <%= booking.checkIn.toDateString() %></p>
            <p><strong>Check-Out:</strong> <%= booking.checkOut.toDateString() %></p>
            <p><strong>Guests:</strong> <%= booking.guests %></p>
            
            <a href="/listings/<%= booking.listing._id %>" 
               class="btn btn-primary btn-sm ">View Listing</a>
                <form method="POST" action="/listings/<%= booking.listing._id %>/bookings/<%= booking._id %>?_method=DELETE" class="d-inline">
    <button class="btn btn-danger btn-sm ms-3">Cancel </button>
  </form>
              
          </div>
        </div>
      </div>
    <% }) %>
  </div>
<% } %>


